<configuration debug="false">
    <!-- Enhanced log pattern with timestamp, level, thread, logger, and message -->
    <property name="LOG_PATTERN" value="%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Set specific log levels for Aeron components -->
    <logger name="io.aeron.samples" level="INFO"/>
    <logger name="io.aeron.cluster" level="INFO"/>
    <logger name="io.aeron.archive" level="WARN"/>
    <logger name="io.aeron.driver" level="WARN"/>

    <root level="${LOG_LEVEL:-info}">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
